#!/bin/sh
# Generate source-backed catalog files before a local commit.
# Enable once per source checkout: git config core.hooksPath skill-sync/hooks
set -eu
root="$(git rev-parse --show-toplevel)"
cd "$root"

if command -v python3 >/dev/null 2>&1; then
  python_cmd=python3
elif command -v python >/dev/null 2>&1; then
  python_cmd=python
else
  echo "[skill-sync] Python is required for README/marketplace generation." >&2
  exit 1
fi

"$python_cmd" skill-sync/scripts/gen_readme.py
"$python_cmd" skill-sync/scripts/gen_marketplace.py
git add -- README.md .agents/plugins/marketplace.json
