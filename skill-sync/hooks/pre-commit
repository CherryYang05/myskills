#!/bin/sh
# 提交前自动刷新仓库 README（Skills 表格等三段）。
# 启用方式（每台机器一次）：git config core.hooksPath skill-sync/hooks
root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0
python skill-sync/scripts/gen_readme.py >/dev/null 2>&1 \
  || python3 skill-sync/scripts/gen_readme.py >/dev/null 2>&1
git add README.md 2>/dev/null
exit 0
